{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Interpreter",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/interpreter.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Interpreter (step into libraries)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/interpreter.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Log summary",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/log_tools.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
